meta {
  name: Get tenant-b token
  type: http
  seq: 2
}

post {
  url: https://{{auth0_domain}}/oauth/token
  body: json
  auth: none
}

body:json {
  {
    "client_id": "{{tenant_b_client_id}}",
    "client_secret": "{{tenant_b_client_secret}}",
    "audience": "{{audience}}",
    "grant_type": "client_credentials"
  }
}

vars:post-response {
  tenant_b_token: res.body.access_token
}

assert {
  res.status: eq 200
}

tests {
  test("issues a token", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });

  test("token carries this tenant's id", function() {
    const segment = res.getBody().access_token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
    const payload = JSON.parse(Buffer.from(segment, "base64").toString("utf8"));
    expect(payload["https://gatekeeper/tenant_id"]).to.equal("tenant-b");
  });
}
